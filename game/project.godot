; Engine configuration file.
; AETHERA — original creature RPG. Godot 4.6.3. Offline-first.
config_version=5

[application]

config/name="Aethera"
config/description="An original creature RPG. Fully offline. No Nintendo IP."
config/version="0.1.0-p01"
config/tags=PackedStringArray("rpg", "offline", "original")
run/main_scene="res://scenes/boot/title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/enable_input=false

[autoload]

GameVersion="*res://src/app/game_version.gd"
InputRouter="*res://src/app/input_router.gd"
DataRegistry="*res://src/data/data_registry.gd"
SaveService="*res://src/save/save_service.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

accept={
"deadzone": 0.5,
"events": []
}
cancel={
"deadzone": 0.5,
"events": []
}
menu={
"deadzone": 0.5,
"events": []
}
run={
"deadzone": 0.5,
"events": []
}
pause={
"deadzone": 0.5,
"events": []
}

[physics]

3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
