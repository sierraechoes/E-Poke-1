{
  "name": "twig-d-capra-aftis",
  "version": "1.0.0",
  "description": "Twig D. Capra — Advanced Futures Trading Integrated Systems (AFTIS v1.0 PRO). Zero-mock, mathematically rigorous trading system: stochastic pricing, PDE solvers, microstructure, OMS/EMS, risk gateways, HFT Hawkes simulator, quant studio.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run tests/stress-throughput.test.ts",
    "test:math": "vitest run tests/math-accuracy.test.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "bench": "vitest run tests/stress-throughput.test.ts --reporter=verbose"
  },
  "engines": {
    "node": ">=18"
  },
